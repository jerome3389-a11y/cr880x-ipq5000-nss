#!/bin/sh /etc/rc.common
# One-shot WiFi preset for the CR880x (M79A/M81).
#
# Why this exists (and why the preset is not in 99-custom): the wireless
# config is generated by the ieee80211 hotplug (/sbin/wifi config) after
# ath11k loads, which runs asynchronously after uci-defaults. When
# 99-custom runs, the radio sections do not exist yet, so uci set on
# wireless is a no-op — that is why #29 and #30 booted with WiFi off,
# no password, default SSIDs. (A wait loop + wifi config in 99-custom,
# tried in f45835b6, made the first boot ~30 s slower and still did not
# apply the preset.) This service runs late (START=99), after the
# hotplug has had the whole boot to generate the config; it waits for
# both radios to exist, applies the preset, reloads wifi, and records a
# flag so it never runs again. A factory re-flash wipes the overlay, so
# the flag is gone and it runs again on the next first boot.
#
# Preset (user 2026-11-10): SSID OpenWrt / OpenWrt_5G, psk2, key
# 12345678, 5G: CN, ch36, HE160; 2G: driver default, HE20; 802.11k/v on.
# Set by radio name only (radio0 = 2G, radio1 = 5G). No paths are
# written: the device paths come from the image's own wireless defaults,
# so a wrong baked path (the JDCloud #4 failure: extra 'libwrt' network,
# WiFi dead) cannot happen here.

START=99

FLAG=/etc/wifi-preset-done

start() {
	[ -f "$FLAG" ] && return 0
	# Wait for the wireless config to have both radios AND both SSID
	# sections (generated by the ieee80211 hotplug). A phy appearing
	# does not prove the generator has finished, so wait for the
	# actual sections this script is going to change. Bound the wait
	# so a missing radio cannot hang the boot; if the config never
	# appears, exit WITHOUT the flag so a later boot can retry.
	_i=0
	while [ "$_i" -lt 30 ]; do
		uci -q get wireless.radio0 >/dev/null 2>&1 && \
		uci -q get wireless.radio1 >/dev/null 2>&1 && \
		uci -q get wireless.default_radio0 >/dev/null 2>&1 && \
		uci -q get wireless.default_radio1 >/dev/null 2>&1 && break
		sleep 1
		_i=$((_i + 1))
	done
	uci -q get wireless.radio0 >/dev/null 2>&1 || return 0
	uci -q get wireless.radio1 >/dev/null 2>&1 || return 0
	uci -q get wireless.default_radio0 >/dev/null 2>&1 || return 0
	uci -q get wireless.default_radio1 >/dev/null 2>&1 || return 0
	uci set wireless.radio0.band='2g'
	uci set wireless.radio0.channel='auto'
	uci set wireless.radio0.htmode='HE20'
	uci set wireless.radio0.cell_density='0'
	uci set wireless.radio0.disabled='0'
	uci set wireless.default_radio0.ssid='OpenWrt'
	uci set wireless.default_radio0.encryption='psk2'
	uci set wireless.default_radio0.key='12345678'
	uci set wireless.default_radio0.ieee80211k='1'
	uci set wireless.default_radio0.ieee80211v='1'
	# Multicast to unicast: multicast frames go at the lowest basic
	# rate (6M) with no ACK; converting to unicast sends them at
	# normal rates with ACKs (better for mDNS/AirPlay/discovery).
	# Home AP with a few clients: clear win, negligible cost.
	# NOTE: the wifi option is multicast_to_unicast_all (LuCI
	# checkbox + hostapd.sh). multicast_to_unicast is a bridge-port
	# option, not a wifi-iface one — hostapd and LuCI ignore it here.
	uci set wireless.default_radio0.multicast_to_unicast_all='1'
	# 802.11v actually needs bss_transition + wnm_sleep_mode: this
	# base's ap.uc does NOT read config.ieee80211v (verified in
	# ap.uc:189 — it only appends bss_transition/wnm_sleep_mode to
	# hostapd.conf). ieee80211v='1' is kept for LuCI display, but
	# without these two lines BSS transition and WNM Sleep Mode are
	# silently off. wnm_sleep_mode lets clients sleep with traffic
	# buffered at the AP (battery saving, 802.11v WNM).
	uci set wireless.default_radio0.bss_transition='1'
	uci set wireless.default_radio0.wnm_sleep_mode='1'
	uci set wireless.default_radio0.disabled='0'
	uci set wireless.radio1.band='5g'
	uci set wireless.radio1.country='CN'
	uci set wireless.radio1.channel='36'
	uci set wireless.radio1.htmode='HE160'
	uci set wireless.radio1.cell_density='0'
	uci set wireless.radio1.disabled='0'
	uci set wireless.default_radio1.ssid='OpenWrt_5G'
	uci set wireless.default_radio1.encryption='psk2'
	uci set wireless.default_radio1.key='12345678'
	uci set wireless.default_radio1.ieee80211k='1'
	uci set wireless.default_radio1.ieee80211v='1'
	# See radio0: multicast to unicast (multicast_to_unicast_all).
	uci set wireless.default_radio1.multicast_to_unicast_all='1'
	# See radio0: ap.uc ignores ieee80211v; bss_transition +
	# wnm_sleep_mode are what actually enable 802.11v in hostapd.
	uci set wireless.default_radio1.bss_transition='1'
	uci set wireless.default_radio1.wnm_sleep_mode='1'
	uci set wireless.default_radio1.disabled='0'
	uci commit wireless || return 0
	# Only record the preset as done if the reload actually applies
	# it; otherwise leave the flag off so a later boot retries.
	wifi reload || return 0
	touch "$FLAG"
}

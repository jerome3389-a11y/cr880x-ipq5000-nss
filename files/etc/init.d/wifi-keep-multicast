#!/bin/sh /etc/rc.common
# Keep multicast-to-unicast + 802.11v options on (LuCI drops them on Save).
#
# Why: LuCI rewrites the whole wireless config on Save, and it drops
# UCI options that aren't checked in its form. multicast_to_unicast_all
# defaults to unchecked, bss_transition/wnm_sleep_mode have NO LuCI
# field at all. So any LuCI WiFi edit silently turns them off, even
# on the radio you didn't touch. The one-shot wifi-preset only runs
# on first boot, so it can't restore them.
# NOTE: the wifi option is multicast_to_unicast_all (LuCI checkbox +
# hostapd.sh). multicast_to_unicast is a bridge-port option, not a
# wifi-iface one — hostapd and LuCI ignore it here. An older
# wifi-preset set the wrong name; this script deletes it.
#
# This service runs on every boot (START=99, after wifi-preset) and
# re-applies ONLY these options per interface, if missing or
# off. It never touches SSID, password, channel, htmode, country,
# or anything else you set in LuCI. If nothing changed, it exits
# without reloading wifi. The 802.11v extras wnm_sleep_mode_no_keys
# ('1') and time_advertisement ('2') are also restored here; both
# are read by ap.uc (lines 189/350), in the schema, and in LuCI's
# roaming tab, but LuCI Save drops them when unchecked like the rest.

START=99

start() {
	_changed=0
	for _iface in default_radio0 default_radio1; do
		uci -q get "wireless.$_iface" >/dev/null 2>&1 || continue
		# Delete the wrong option if present (see NOTE above).
		if uci -q get "wireless.$_iface.multicast_to_unicast" >/dev/null 2>&1; then
			uci delete "wireless.$_iface.multicast_to_unicast"
			_changed=1
		fi
		for _opt in multicast_to_unicast_all bss_transition wnm_sleep_mode wnm_sleep_mode_no_keys; do
			[ "$(uci -q get "wireless.$_iface.$_opt")" = "1" ] && continue
			uci set "wireless.$_iface.$_opt='1'"
			_changed=1
		done
		[ "$(uci -q get "wireless.$_iface.time_advertisement")" = "2" ] || {
			uci set "wireless.$_iface.time_advertisement='2'"
			_changed=1
		}
	done
	[ "$_changed" = "1" ] || return 0
	uci commit wireless || return 0
	wifi reload
}

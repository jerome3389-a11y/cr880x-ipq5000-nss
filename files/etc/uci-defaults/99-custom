#!/bin/sh
# First-boot customizations for ipq50xx-openwrt-nss.
# Runs once on first boot (the uci-defaults mechanism removes this file
# afterwards). No set -e: a failed step must not abort the rest.
# Kept presets (user decision 2026-11-07): BBR, Argon theme, NSS on.
# (NSS is on via the base-tree plane; it is NOT enabled via the
# qca-nss-drv init script — see the 2026-11-08 removal note below.)
# Removed 2026-11-07: DNS hijack (hardcoded LAN IP broke on LAN IP change),
# dnsmasq cachesize (redundant, default 1000), interface='lan', cache_rr
# (A/AAAA redundant defaults; ANY removed with the trim).
# Removed 2026-11-08 (user: delete dead code): the qca-nss-drv enable
# block. It did nothing lasting: this script runs before the base tree's
# nss-dwmac.defaults, which disables qca-nss-drv again in the same first
# boot on purpose (its init only does IRQ affinity + RPS from a quad-core
# ipq807x table, before the plane is armed; nss-irq-affinity does the job
# after arming). NSS itself stays on via the plane (driver loads via
# modules.d), so no enable block is needed here.
# Fixed 2026-11-09 (user: fix firmware): WAN gets its own factory MAC —
# see the block before exit 0. The two factory MACs differ per unit, so
# they are read live, never hardcoded.

# --- TCP BBR as the default congestion control ---
# Kernel-config default does not survive defconfig on this tree, so set
# it here: persist in sysctl.conf for every boot, and apply live now
# (the tcp_bbr module is already loaded via modules.d by this point).
grep -q '^net.ipv4.tcp_congestion_control=bbr$' /etc/sysctl.conf 2>/dev/null || \
  echo 'net.ipv4.tcp_congestion_control=bbr' >> /etc/sysctl.conf
sysctl -w net.ipv4.tcp_congestion_control=bbr >/dev/null 2>&1

# --- Argon as the default LuCI theme ---
# Both Argon and Bootstrap are installed; Bootstrap is OpenWrt's
# fallback default, so set Argon explicitly (reversible in LuCI).
uci set luci.main.mediaurlbase='/luci-static/argon'
uci commit luci

# --- WAN gets its own factory MAC (user decision 2026-11-09) ---
# DSA collapses WAN and br-lan onto one MAC (eth1's, the LAN-path MAC
# from ART offset 6). eth0 holds the other factory MAC (ART offset 0,
# the WAN-path MAC) but nothing uses it. Give WAN eth0's MAC so each
# side has its own factory MAC; br-lan keeps eth1's. Read it live: the
# two MACs differ per unit, so never hardcode them. This runs before
# network starts, so the setting is picked up in this same first boot.
WAN_MAC="$(cat /sys/class/net/eth0/address 2>/dev/null)"
[ -n "$WAN_MAC" ] && uci set network.wan.macaddr="$WAN_MAC"
uci commit network

exit 0

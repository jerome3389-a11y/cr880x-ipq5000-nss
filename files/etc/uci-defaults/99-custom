#!/bin/sh
# First-boot customizations for ipq50xx-openwrt-nss.
# Runs once on first boot (the uci-defaults mechanism removes this file
# afterwards). No set -e: a failed step must not abort the rest.
# This script holds personalized config only (user decision 2026-11-09:
# scripts are for personalized config): Adblock, WiFi, timezone.
# BBR lives in files/etc/sysctl.conf and Argon in files/etc/config/luci
# now (static files, no script). NSS is on via the base-tree plane.
# Removed 2026-11-07: DNS hijack (hardcoded LAN IP broke on LAN IP change),
# dnsmasq cachesize (redundant, default 1000), interface='lan', cache_rr
# (A/AAAA redundant defaults; ANY removed with the trim).
# Removed 2026-11-08 (user: delete dead code): the qca-nss-drv enable
# block. It did nothing lasting: this script runs before the base tree's
# nss-dwmac.defaults, which disables qca-nss-drv again in the same first
# boot on purpose (its init only does IRQ affinity + RPS from a quad-core
# ipq807x table, before the plane is armed; nss-irq-affinity does the job
# after arming). NSS itself stays on via the plane (driver loads via
# modules.d), so no enable block is needed here.

# --- Adblock: make sure the service is enabled ---
# The feeds and adb_enabled='1' live in files/etc/config/adblock. The
# service is enabled by default, so this is belt and braces: it starts
# at its own boot order, after the network is up, and fetches the lists
# then. No start here — this runs before network starts.
/etc/init.d/adblock enable >/dev/null 2>&1

# --- WiFi: enable both radios with the usual SSIDs (preset) ---
# Set by radio name only (radio0 = 2G, radio1 = 5G). No paths are written:
# the device paths come from the image's own wireless defaults, so a
# wrong baked path (the JDCloud #4 failure: extra 'libwrt' network, WiFi
# dead) cannot happen here. No country set (user: region stays as-is).
# Channel auto, 5G 160 MHz, 2G 20 MHz, 802.11k/v on (user 2026-11-10).
# Why the wait + wifi config below: the wireless config is generated by
# the ieee80211 hotplug (/sbin/wifi config), which runs asynchronously
# after ath11k loads — the radio sections do not exist yet when this
# script runs, so plain uci set is a no-op. That is why #29 booted with
# WiFi off, no password, default SSIDs. Wait for the radios, generate
# the config, then set the preset. mac80211.uc only adds radios that
# are missing, so a later hotplug wifi config will not overwrite this.
# Also enable the SSID itself: the generated config disables the
# wifi-iface (default_radioX.disabled='1'); setting only the radio's
# disabled='0' leaves the SSID off.
for _i in $(seq 1 30); do
	[ -n "$(ls -A /sys/class/ieee80211 2>/dev/null)" ] && break
	sleep 1
done
/sbin/wifi config
uci set wireless.radio0.band='2g'
uci set wireless.radio0.channel='auto'
uci set wireless.radio0.htmode='HE20'
uci set wireless.radio0.cell_density='0'
uci set wireless.radio0.disabled='0'
uci set wireless.default_radio0.ssid='OpenWrt'
uci set wireless.default_radio0.encryption='psk2'
uci set wireless.default_radio0.key='12345678'
uci set wireless.default_radio0.ieee80211k='1'
uci set wireless.default_radio0.ieee80211v='1'
uci set wireless.default_radio0.disabled='0'
uci set wireless.radio1.band='5g'
uci set wireless.radio1.channel='auto'
uci set wireless.radio1.htmode='HE160'
uci set wireless.radio1.cell_density='0'
uci set wireless.radio1.disabled='0'
uci set wireless.default_radio1.ssid='OpenWrt_5G'
uci set wireless.default_radio1.encryption='psk2'
uci set wireless.default_radio1.key='12345678'
uci set wireless.default_radio1.ieee80211k='1'
uci set wireless.default_radio1.ieee80211v='1'
uci set wireless.default_radio1.disabled='0'
uci commit wireless

# --- Timezone: Asia/Shanghai (preset, added 2026-11-10) ---
uci set system.@system[0].timezone='CST-8'
uci set system.@system[0].zonename='Asia/Shanghai'
uci commit system

exit 0

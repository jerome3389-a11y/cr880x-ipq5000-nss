--- a/package/nss/nss-tools/files/functions.sh
+++ b/package/nss/nss-tools/files/functions.sh
@@ -156,21 +156,31 @@
 }
 
 # nss_dsa_fw_mask: which GMACs to hand to the firmware, from what is up:
-# the conduit that carries the user ports, and every GMAC that is not a
+# every conduit that carries user ports, and every GMAC that is not a
 # conduit and is administratively up - a WAN PHY of its own (Xunison D50,
-# Linksys SPNMX56, Xiaomi AX6000). What stays out: a second CPU port DSA
-# does not use (AX5400, PZ-L8), and a GMAC nothing configured (the CMCC
-# MR3000D-CI's GMAC0). Meant to run after netifd, when "up" means
+# Linksys SPNMX56, Xiaomi AX6000). What stays out: a GMAC nothing
+# configured (the CMCC MR3000D-CI's GMAC0), and a second CPU port with no
+# user ports (AX5400, PZ-L8). A board whose split is kept (cr8806, cr8808)
+# arms both conduits. Meant to run after netifd, when "up" means
 # "configured". Sets NSS_FW_MASK as 0x<hex>; never 0x0 while there is a
 # conduit.
 nss_dsa_fw_mask() {
-	local e i n flags mask=0
+	local e i n p u cnt flags mask=0
 	nss_dsa_conduit
 	for e in $(nss_gmac_netdevs); do
 		i="${e%%:*}"
 		n="${e#*:}"
 		if [ -d "/sys/class/net/$n/dsa" ]; then
-			[ "$n" = "$NSS_CONDUIT" ] || continue
+			# Count the user ports DSA hangs off this conduit;
+			# a conduit with none is not armed.
+			cnt=0
+			for u in "/sys/class/net/$n"/upper_*; do
+				[ -e "$u" ] || continue
+				p="${u##*/upper_}"
+				[ -n "$(cat "/sys/class/net/$p/phys_switch_id" 2>/dev/null)" ] || continue
+				cnt=$((cnt + 1))
+			done
+			[ "$cnt" -gt 0 ] || continue
 		else
 			flags="$(cat "/sys/class/net/$n/flags" 2>/dev/null || echo 0)"
 			[ $(( flags & 1 )) -ne 0 ] || continue
--- a/package/nss/nss-tools/files/nss-dwmac-up
+++ b/package/nss/nss-tools/files/nss-dwmac-up
@@ -68,8 +68,8 @@
   MASK="$(uci -q get nss.general.fw_mask)" || MASK=''
   if [ -z "$MASK" ] && [ "$TOPOLOGY" = "dsa" ]; then
     # C-3PO: netifd has run, so a GMAC that is up is one that is in use -
-    # the conduit and any WAN PHY of its own get armed, an unused GMAC or
-    # a second CPU port DSA does not use stay on the host.
+    # every conduit with user ports and any WAN PHY of its own get armed,
+    # an unused GMAC or a second CPU port with no user ports stay on the host.
     nss_dsa_fw_mask
     MASK="$NSS_FW_MASK"
     echo "topology dsa: fw_mask $MASK from the board (conduit ${NSS_CONDUIT:-none} = phys_if ${NSS_CONDUIT_IF:--}, GMACs $(nss_gmac_netdevs | tr '\n' ' '))"

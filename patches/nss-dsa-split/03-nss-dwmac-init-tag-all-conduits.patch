 # nothing to switch. nss.general.trunk still overrides the conduit.
 switch_to_8021q() {
-	local trunk tagging cur want other stray port up
+	local trunk tagging cur want other stray port up conduits failed=0
 
 	trunk="$(uci -q get nss.general.trunk)"
 	if [ -z "$trunk" ]; then
@@ -167,11 +167,13 @@
 		logger -t nss "topology dsa: no DSA switch on this board - the GMACs go to the firmware as they are"
 		return 0
 	fi
-	# Ports left on another CPU link are invisible to the firmware:
-	# qca-dsa-nss hangs its VLAN interfaces off this conduit's interface
-	# number alone. The first-boot defaults put every port on one link, so
-	# this is about a board table that splits them (the AX5400 and the

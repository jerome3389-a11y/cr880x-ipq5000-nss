+	for trunk in $conduits; do
+		tagging="/sys/class/net/$trunk/dsa/tagging"
+		cur="$(cat "$tagging" 2>/dev/null)"
+		if [ -z "$cur" ]; then
+			logger -t nss "topology dsa: $trunk is not a DSA conduit, nothing to switch"
+			failed=1
+			continue
+		fi
+		want="$(nss_dsa_tagger "$trunk")" || {
+			logger -t nss "topology dsa: no tag_8021q tagger for the switch behind $trunk (driver $want) - the firmware will not parse this traffic"
+			failed=1
+			continue
+		}
+		[ "$cur" = "$want" ] && continue

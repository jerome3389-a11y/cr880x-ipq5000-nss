+	# Every conduit with user ports needs both links in plain 802.1Q:
+	# the firmware parses the tag, the host tag does not parse. The
+	# first-boot defaults put every port on one link, so a second
+	# conduit with ports is about a board table that splits them (the
+	# AX5400 and the PZ-L8 do) on a config that predates that, an
+	# admin's own split, or a board whose split is kept.
+	conduits="$trunk"
 	for other in /sys/class/net/*; do
 		[ -d "$other/dsa" ] || continue
 		other="${other##*/}"
@@ -183,36 +185,41 @@
 			[ -n "$(cat "/sys/class/net/$port/phys_switch_id" 2>/dev/null)" ] || continue
 			stray="$stray $port"
 		done
-		[ -n "$stray" ] && logger -t nss "topology dsa:$stray on conduit $other, not $trunk - those ports stay on the host path (a 'config device' section with option name <port> and option conduit $trunk moves one; board.d's split is in /etc/board.json, not in /etc/config/network)"
+		[ -n "$stray" ] && conduits="$conduits $other"
 	done
-	tagging="/sys/class/net/$trunk/dsa/tagging"

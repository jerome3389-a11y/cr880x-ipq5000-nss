# --- Deliberately NOT configured here (runtime defaults, not .config) ---
# Kernel flow offloading (firewall.@defaults[0].flow_offloading) MUST be OFF:
# a flowtable forwards established TCP flows before ECM classifies them,
# so ECM never sees the flow. The base tree's first boot clears it
# (98-nss-offload); the smoke test asserts `nft list flowtables` is empty.
# SQM is OFF by default. If NSS SQM is wanted later, it is nssfq_codel on
# the conduit (eth0) on the DSA topology, never on the DSA port (wan).
# IGMP snooping stays OFF on switch bridges (base default).

# --- Removed 2026-11-11 (audit: useless on this hardware, user-approved) ---
# USB stack: the CR880x USB port is never used. Removing the whole stack
# means the USB controller never binds; USB stops working entirely.
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-dwc3 is not set
# CONFIG_PACKAGE_kmod-usb-dwc3-qcom is not set
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb-xhci-hcd is not set
# CONFIG_PACKAGE_kmod-usb-roles is not set
# CONFIG_PACKAGE_kmod-usb-common is not set
# ext4 stack: rootfs is squashfs on UBI, overlay is UBIFS; nothing
# mounts ext4. These are qualcommax target defaults, not needed here.
# CONFIG_PACKAGE_kmod-fs-ext4 is not set
# CONFIG_PACKAGE_e2fsprogs is not set
# CONFIG_PACKAGE_libext2fs is not set
# CONFIG_PACKAGE_libe2p is not set
# CONFIG_PACKAGE_libcomerr is not set
# CONFIG_PACKAGE_libss is not set
# uboot-envtools: reads/writes U-Boot env from OpenWrt (fw_printenv /
# fw_setenv). Flashing is via the trigsoft web U-Boot UI; U-Boot env is
# never edited from OpenWrt. Deleting it does NOT affect sysupgrade
# (already unusable on this device: no platform upgrade script).
# CONFIG_PACKAGE_uboot-envtools is not set
# MAC80211_DEBUGFS: mac80211 debugfs (/sys/kernel/debug/ieee80211/).
# Debug-only interface; not used in a production image.
# CONFIG_PACKAGE_MAC80211_DEBUGFS is not set

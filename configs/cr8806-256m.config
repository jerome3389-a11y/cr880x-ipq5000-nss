# Baseline .config fragment for Xiaomi CR8806 (256m group)
#
# This is a FRAGMENT, not a full .config. The workflow copies it to .config
# and runs `make defconfig`, which expands it against the kuncy7 tree
# (openwrt-nss-edma, branch c3po-tag-8021q, kernel 6.18).
#
# Symbol names below come from the project research report (base-source
# recommendation section). The workflow greps the expanded .config after
# defconfig and fails the build if a required symbol was dropped, so a
# wrong symbol name fails loudly instead of silently producing a
# non-NSS image.
#
# Device: Xiaomi CR8806, M79 board revision, IPQ5018 + QCN6122 + QCA8337,
# 256 MB RAM -> 256m group: ath11k 256M profile, NSS low memory profile.
# This is the A版 M79 configuration; the A版 M81 variant is
# configs/cr8808-m81-256m.config (its board data comes from the
# files-xiaomi_cr8808/ overlay, not from an ipq-wifi package).
# Linux sees about 169 MiB on this board with 20-30 MiB free at idle,
# so keep the package set small.

# Target: qualcommax/ipq50xx, device profile xiaomi_cr8806
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_xiaomi_cr8806=y

# --- NSS plane (must all survive defconfig) ---
# nss-tools-dwmac MUST be =y, never =m: =m builds the package but leaves
# it out of the image, and the boot then looks exactly like NSS working
# while fw_mask stays 0x0.
CONFIG_PACKAGE_nss-tools-dwmac=y
CONFIG_PACKAGE_nss-firmware=y
# Firmware line: 12.5-210-MP is the default. The workflow swaps this pair
# to 12.2 when the firmware input is 12.2. Never enable both: the driver
# is built for exactly one firmware version.
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
# CONFIG_NSS_FIRMWARE_VERSION_12_2 is not set
# 256 MB boards must use the low NSS memory profile (MEDIUM is for 512 MB+).
CONFIG_NSS_MEM_PROFILE_LOW=y
CONFIG_NSS_DRV_VLAN_ENABLE=y
CONFIG_NSS_DRV_IPV6_ENABLE=y
CONFIG_NSS_DRV_VIRT_IF_ENABLE=y
# PPPoE manager: without it, ECM tracks PPPoE flows but never offloads
# them, with nothing in the log.
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
# Wi-Fi offload (wifili) for both radios, incl. the QCN6122 5 GHz radio.
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y
CONFIG_ATH11K_NSS_SUPPORT=y
# 256M profile reverted 2026-11-04 (#15 cleanup): falsified as a WiFi fix
# by #13 (profile active, board-data still -12); the fix was the 0:ART
# caldata overlay (#14). Base default (n) restored.
CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE=y
# QCN6122 firmware for IPQ5018 (WLAN.HK.2.7.0.1 line). Do NOT substitute
# the single-PD ath11k-firmware-ipq5018: the stock 2.9.r4 line is reported
# to crash the 2.4 GHz Q6.
CONFIG_PACKAGE_ath11k-firmware-ipq5018-qcn6122=y
# Wireless driver is kmod-ath11k-ahb (target DEFAULT_PACKAGES, #15 cleanup):
# the plain kmod-ath11k line (added #9 on the config.buildinfo misreading)
# is redundant — the AHB driver is what the radios use and is selected by
# default. Removed 2026-11-04.
# ath11k requires @DRIVER_11AC_SUPPORT + @DRIVER_11AX_SUPPORT. Both are bool
# default n in hostapd/Config.in and nothing selects them, so they must be
# set explicitly here; without them defconfig drops kmod-ath11k-ahb (and
# with it the whole mac80211 stack) even though it is a target default.
CONFIG_DRIVER_11AC_SUPPORT=y
CONFIG_DRIVER_11AX_SUPPORT=y
# Full wpad-mbedtls (2026-11-04, #15): replaces the target default
# wpad-basic-mbedtls. Full wpad provides WNM (802.11v, on by default) and
# MESH (802.11s, manually controllable); basic has WNM off and no MESH.
# Same mbedtls TLS backend.
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_wpad-mbedtls=y
CONFIG_PACKAGE_iw=y
# iwinfo removed 2026-11-04 (#15 cleanup): LuCI uses rpcd-mod-iwinfo, not
# the iwinfo CLI; iw kept as the on-device WiFi debug tool.

# --- Verification tools removed for a minimal image ---
# ip-full and iperf3 were here for on-device verification only; they are
# not needed for routing or NSS offload, so they are out. Reinstall via
# opkg later if a test is needed.

# --- initramfs image, needed for UART+TFTP first install on CR8806 ---
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# --- LuCI ---
# kuncy7 CR8806 releases include LuCI, but it costs RAM on a 256 MB board.
# Measure free memory before keeping it; delete this line if the board OOMs.
CONFIG_PACKAGE_luci=y

# --- ZRAM swap (from IPQ60xx study, 2026-11-02) ---
# 256 MB board: compressed RAM swap beats OOM kills. zram-swap brings up
# a zram swap device at boot; LZ4 is the default compressor, LZO is kept
# as a fallback backend.
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZ4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZO=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4=y

# --- TCP BBR congestion control (from IPQ60xx study, 2026-11-02) ---
# Module only. Setting the default via kernel config does NOT work on
# this tree: DEFAULT_TCP_CONG is dropped by defconfig in both the plain
# and the CONFIG_KERNEL_ form (run #4's loop proved it). The default is
# instead set at first boot by the uci-defaults script (sysctl.conf +
# live sysctl), which is the standard OpenWrt way.
CONFIG_PACKAGE_kmod-tcp-bbr=y

# --- ccache (from IPQ60xx study, 2026-11-02) ---
# The workflow caches openwrt/.ccache between runs; without this symbol
# the cache directory stays empty.
CONFIG_CCACHE=y

# --- NSS plane additions (from run #1 buildinfo check, 2026-11-02) ---
# Run #1's buildinfo confirmed ecm, pppoe and vlan-mgr. bridge-mgr is
# NOT included: qca-nss-clients gates it to ipq807x/ipq60xx only
# (it needs the PPE stack, which the ipq50xx EDMA tree does not have),
# so defconfig drops it on ipq50xx. nft-nat is the nftables NAT module
# (masquerade); made explicit so it is guaranteed present.
CONFIG_PACKAGE_kmod-nft-nat=y

# --- Argon theme (from IPQ60xx study, 2026-11-02) ---
# Fetched by the workflow into package/ (not in the base feeds).
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# --- Small tools (from IPQ60xx study, 2026-11-02) ---
# luci-app-cpufreq and luci-app-arpbind are NOT in the pinned luci feed
# (checked 2026-11-02 at 5599f42b), so they are deliberately absent:
# defconfig drops them and the fail-fast loop fails the build.
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_zoneinfo-asia=y
# luci-app-ttyd and openssh-sftp-server removed 2026-11-03: the user
# does not use them (tftp suffices for transfers).
CONFIG_PACKAGE_luci-app-upnp=y
# Packet capture (added 2026-11-03, user choice).
CONFIG_PACKAGE_tcpdump-mini=y

# --- Target optimization (from IPQ60xx study, 2026-11-02) ---
# The user tested these flags to pass cloud builds. -O3 with Cortex-A53
# plus crypto flags; this triggers a full toolchain rebuild on the next
# run. LTO is enabled the same way as the IPQ60xx project
# (CONFIG_USE_LTO=y, added 2026-11-03); that project's own config warns
# LTO eats builder memory and says to turn it off first if the build
# fails on memory.
CONFIG_DEVEL=y
CONFIG_TARGET_OPTIONS=y
CONFIG_USE_LTO=y
CONFIG_TARGET_OPTIMIZATION="-O3 -pipe -march=armv8-a+crypto+crc -mcpu=cortex-a53+crypto+crc -mtune=cortex-a53"

# --- NSS SQM hardware queue (added 2026-11-02) ---
# nssfq_codel on the conduit (eth0) on the DSA topology, never on the
# DSA port (wan). sqm-scripts-nss comes from the kuncy7 nss feed
# (verified present in kuncy7/nss-packages).
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_kmod-ifb=y

# --- LuCI NSS status (added 2026-11-11) ---
# luci-app-nss shows NSS core load, ECM accelerated connections and SoC
# temperatures on the LuCI status page (Overview + a Status -> NSS Offload
# page), the same display as the main router. Read-only widget; it reads
# /sys/kernel/debug/qca-nss-drv/stats/cpu_load_ubi,
# /sys/kernel/debug/ecm/ecm_nss_ipv{4,6}/accelerated_count and
# /sys/class/thermal (the TSENS zones added to the DTS feed the temperature
# part). Depends on nss-tools-dwmac, already =y.
CONFIG_PACKAGE_luci-app-nss=y

# --- Fullcone NAT: NOT included (removed 2026-11-02) ---
# No fullcone package exists in the pinned feeds (packages/net at
# 18af3f1b has no fullcone entry), so kmod-nft-fullcone is dropped by
# defconfig and the fail-fast loop fails the build. Do not re-add it
# without first confirming a fullcone package in the pinned feeds;
# the first-boot script must not set the firewall fullcone option
# either, or firewall4 would fail loading a rule it cannot build.

# --- dnsmasq caching resolver (switched from SmartDNS 2026-11-03) ---
# dnsmasq-full replaces the base default dnsmasq (adblock needs its
# nftset support); same config section, same cache setting.
# The first-boot uci-defaults script raises its cache size so repeated
# queries are answered locally instead of going upstream again.
# The DNS hijack in the first-boot script still applies: all LAN
# port 53 traffic goes to the router, now landing on dnsmasq.
# ca-bundle is kept for TLS verification (opkg/LuCI https), not for DNS.
CONFIG_PACKAGE_ca-bundle=y

# --- Adblock (added 2026-11-03) ---
# adblock needs dnsmasq-full (nftset support); standard dnsmasq lacks it.
# dnsmasq-full is a drop-in replacement: same config, same cache setting.
# Feeds are preset in files/etc/config/adblock (anti_ad for CN + adguard,
# yoyo, disconnect); the lists themselves download on first boot with
# internet (they go stale, so they are NOT baked into the image).
# Large feeds (XL/XXL/VAR in adblock.feeds) are deliberately NOT enabled:
# list size drives dnsmasq RAM on this 256 MB board.
# No luci-app-adblock: managed over SSH.
CONFIG_PACKAGE_adblock=y
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set

# --- Deliberately NOT configured here (runtime defaults, not .config) ---
# Kernel flow offloading (firewall.@defaults[0].flow_offloading) MUST be OFF:
# a flowtable forwards established TCP flows before ECM classifies them,
# so ECM never sees the flow. The base tree's first boot clears it
# (98-nss-offload); the smoke test asserts `nft list flowtables` is empty.
# SQM is OFF by default. If NSS SQM is wanted later, it is nssfq_codel on
# the conduit (eth0) on the DSA topology, never on the DSA port (wan).
# IGMP snooping stays OFF on switch bridges (base default).

# --- Removed 2026-11-11 (audit: useless on this hardware, user-approved) ---
# USB stack: the CR880x USB port is never used. Removing the whole stack
# means the USB controller never binds; USB stops working entirely.
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-dwc3 is not set
# CONFIG_PACKAGE_kmod-usb-dwc3-qcom is not set
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb-xhci-hcd is not set
# CONFIG_PACKAGE_kmod-usb-roles is not set
# CONFIG_PACKAGE_kmod-usb-common is not set
# ext4 stack: rootfs is squashfs on UBI, overlay is UBIFS; nothing
# mounts ext4. These are qualcommax target defaults, not needed here.
# CONFIG_PACKAGE_kmod-fs-ext4 is not set
# CONFIG_PACKAGE_e2fsprogs is not set
# CONFIG_PACKAGE_libext2fs is not set
# CONFIG_PACKAGE_libe2p is not set
# CONFIG_PACKAGE_libcomerr is not set
# CONFIG_PACKAGE_libss is not set
# uboot-envtools: reads/writes U-Boot env from OpenWrt (fw_printenv /
# fw_setenv). Flashing is via the trigsoft web U-Boot UI; U-Boot env is
# never edited from OpenWrt. Deleting it does NOT affect sysupgrade
# (already unusable on this device: no platform upgrade script).
# CONFIG_PACKAGE_uboot-envtools is not set
# MAC80211_DEBUGFS: mac80211 debugfs (/sys/kernel/debug/ieee80211/).
# Debug-only interface; not used in a production image.
# CONFIG_PACKAGE_MAC80211_DEBUGFS is not set

#!/bin/sh
# First-boot customizations for ipq50xx-openwrt-nss.
# Runs once on first boot (the uci-defaults mechanism removes this file
# afterwards). No set -e: a failed step must not abort the rest.
# This script holds personalized config only (user decision 2026-11-09):
# Adblock and timezone. BBR lives in
# files/etc/sysctl.conf and Argon in files/etc/config/luci now
# (static files, no script). NSS is on via the base-tree plane.
# WiFi preset lives in /etc/init.d/wifi-preset (START=99), NOT here:
# the wireless config is generated by the ieee80211 hotplug AFTER
# uci-defaults run, so uci set on wireless here is a silent no-op.
# The WAN MAC is set by the DTS (nvmem-cells on the wan port, restored
# 2026-11-11 from 110988d9), NOT by UCI here: UCI macaddr does not
# change a DSA user port's MAC (see #33 diagnosis).
# Removed 2026-11-07: DNS hijack (hardcoded LAN IP broke on LAN IP change),
# dnsmasq cachesize (redundant, default 1000), interface='lan', cache_rr
# (A/AAAA redundant defaults; ANY removed with the trim).
# Removed 2026-11-08 (user: delete dead code): the qca-nss-drv enable
# block. It did nothing lasting: this script runs before the base tree's
# nss-dwmac.defaults, which disables qca-nss-drv again in the same first
# boot on purpose (its init only does IRQ affinity + RPS from a quad-core
# ipq807x table, before the plane is armed; nss-irq-affinity does the job
# after arming). NSS itself stays on via the plane (driver loads via
# modules.d), so no enable block is needed here.

# --- Adblock: make sure the service is enabled ---
# The feeds and adb_enabled='1' live in files/etc/config/adblock. The
# service is enabled by default, so this is belt and braces: it starts
# at its own boot order, after the network is up, and fetches the lists
# then. No start here — this runs before network starts.
/etc/init.d/adblock enable >/dev/null 2>&1

# --- Timezone ---
uci set system.@system[0].timezone='CST-8'
uci set system.@system[0].zonename='Asia/Shanghai'
# 24-hour clock in LuCI (Time Format, below the timezone setting):
# clock_hourcycle 'h23' ('' = Default, 'h12' = 12-hour, 'h23' = 24-hour).
uci set system.@system[0].clock_hourcycle='h23'
uci commit system

# --- Packet steering OFF (NSS requirement) ---
# NSS offloads the data path to firmware; OpenWrt's packet-steering
# service (packet-steering.uc) uses a host NAPI model that fights
# firmware RPS and costs throughput (measured: 749-800 Mbit/s off vs
# 619-626 on, with n2h_rx_queue drops). The nss-tools defaults
# (98-nss-offload) set this to '0', but enforce it here too: the
# service re-runs its .uc script on every interface event, and if the
# setting is ever '1' the script does full RPS/XPS placement (9.7% CPU
# observed). '0' makes the script write rps_cpus=0 and stay out of the
# NSS data path.
uci set network.globals.packet_steering='0'
uci commit network

exit 0

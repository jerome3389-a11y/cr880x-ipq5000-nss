// A版 M81 device tree for Xiaomi CR8808 (M81), adapted from kuncy7's
// ipq5018-cr8806.dts (c3po-tag-8021q @ 13e8bc9). The base tree has no M81
// profile, so this file lives in the scaffold repo and the workflow copies
// it into the base tree at build time (see "Install custom devices").
//
// Changes vs the M79 DTS (only identity lines differ; everything else is
// copied verbatim):
//   model: "Xiaomi CR8806 (M79)" -> "Xiaomi CR8808 (M81)"
//   compatible: "xiaomi,cr8806" -> "xiaomi,cr8808"
//   wifi (2.4 GHz) node: qcom,ath11k-calibration-variant -> qcom,board_id
//     = <0x24> (M81, epa); wifi1 (5 GHz) node: -> qcom,board_id = <0x60>
//     (shared 5 GHz entry). Board-id selection mirrors hzyitc, whose
//     hotplug script picks 0x24 for epa (external PA, M81) and 0x10 for
//     ipa (M79) from the OEM wl_pa_type flag.
//
// STATUS - READ BEFORE BUILDING:
// - Switch (QCA8337), SoC (IPQ5018), radios (IPQ5018 + QCN6122), NAND
//   (128 MB, 128k block / 2048 page) and FIT config (config@mp02.1) are
//   copied from M79. hzyitc covers M79 and M81 with a single DTS, which
//   is the evidence they match. Partitions confirmed same as M79
//   (trigsoft merged, 19 entries) by user 2026-11-05, so fixed-
//   partitions (same block as M79) replaces smem-part here. LED/button
//   GPIOs are NOT yet verified on M81 hardware in this tree, and
//   boot + WiFi on a real M81 board are still untested.
// - Board data comes from hzyitc's redmi_ax3000 board files, fetched by
//   the workflow at build time (pinned commit + sha256 check) into the
//   per-device overlay: the 2.4 GHz file carries two entries, board-id
//   0x10 (M79) and 0x24 (M81); this DTS selects 0x24. The 5 GHz file has
//   the single shared board-id 0x60 entry (RTC66568 on both boards).
//   On-device verification is still required: 2.4 GHz power/throughput
//   on real M81 hardware, before trusting the 5.4-era board data on
//   kernel 6.18 ath11k.
// - When the base tree gains a real M81 profile, delete this file and
//   the matching .mk.inc and point the config at the base profile.

// SPDX-License-Identifier: GPL-2.0-or-later OR MIT

/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-qcn6122.dtsi"
#include "ipq5018-nss.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	model = "Xiaomi CR8808 (M81)";
	compatible = "xiaomi,cr8808", "qcom,ipq5018";

	reserved-memory {
		q6_region_qcn6122_1: q6-region-qcn6122-1@4d200000 {
			reg = <0x0 0x4d200000 0x0 0xd00000>;
			no-map;
		};

		m3_dump_qcn6122_1: m3-dump-qcn6122-1@4df00000 {
			reg = <0x0 0x4df00000 0x0 0x100000>;
			no-map;
		};
	};

	aliases {
		serial0 = &blsp1_uart1;
		label-mac-device = &gmac0;
		led-boot = &led_system_blue;
		led-failsafe = &led_system_yellow;
		led-running = &led_system_blue;
		led-upgrade = &led_system_yellow;
	};

	chosen {
		/*
		 * Xiaomi's U-Boot passes ubi.mtd=rootfs or ubi.mtd=rootfs_1
		 * depending on flag_boot_rootfs. Keep it, so OpenWrt can live
		 * in either slot, and only override the root device.
		 *
		 * coherent_pool sizes the three atomic DMA pools (kernel, DMA,
		 * DMA32). 2M was needed while the MPD firmware loader took its
		 * segment buffers from the atomic pool. That loader is no longer
		 * in the kernel (multiPD is done in ath11k), so 512K is enough,
		 * as on the other 256 MiB boards.
		 */
		bootargs-append = " root=/dev/ubiblock0_1 swiotlb=1 coherent_pool=512K";
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset-button {
			label = "reset";
			gpios = <&tlmm 25 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		mesh-button {
			label = "mesh";
			gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		led_system_blue: led-0 {
			gpios = <&tlmm 19 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			default-state = "on";
		};

		led_system_yellow: led-1 {
			gpios = <&tlmm 17 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_YELLOW>;
			function = LED_FUNCTION_STATUS;
		};

		led_internet_blue: led-2 {
			gpios = <&tlmm 22 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WAN;
		};

		led_internet_yellow: led-3 {
			gpios = <&tlmm 20 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_YELLOW>;
			function = LED_FUNCTION_WAN;
		};
	};
};

/*
 * The vendor DT reserves 4 MiB for TZ (upstream: 2 MiB); keep Linux out
 * of the whole region.
 */
&tz_region {
	reg = <0x0 0x4ac00000 0x0 0x400000>;
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 {
	status = "okay";

	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";

	/* TSENS calibration cells (upstream ipq5018.dtsi): the tsens
	 * node below reads these via nvmem. Without them the sensor
	 * has no calibration data and reads garbage.
	 */
	tsens_mode: mode@249 {
		reg = <0x249 0x1>;
		bits = <0 3>;
	};

	tsens_base1: base1@249 {
		reg = <0x249 0x2>;
		bits = <3 8>;
	};

	tsens_base2: base2@24a {
		reg = <0x24a 0x2>;
		bits = <3 8>;
	};

	tsens_s0_p1: s0-p1@24b {
		reg = <0x24b 0x2>;
		bits = <2 6>;
	};

	tsens_s0_p2: s0-p2@24c {
		reg = <0x24c 0x1>;
		bits = <1 6>;
	};

	tsens_s1_p1: s1-p1@24c {
		reg = <0x24c 0x2>;
		bits = <7 6>;
	};

	tsens_s1_p2: s1-p2@24d {
		reg = <0x24d 0x2>;
		bits = <5 6>;
	};

	tsens_s2_p1: s2-p1@24e {
		reg = <0x24e 0x2>;
		bits = <3 6>;
	};

	tsens_s2_p2: s2-p2@24f {
		reg = <0x24f 0x1>;
		bits = <1 6>;
	};

	tsens_s3_p1: s3-p1@24f {
		reg = <0x24f 0x2>;
		bits = <7 6>;
	};

	tsens_s3_p2: s3-p2@250 {
		reg = <0x250 0x2>;
		bits = <5 6>;
	};

	tsens_s4_p1: s4-p1@251 {
		reg = <0x251 0x2>;
		bits = <3 6>;
	};

	tsens_s4_p2: s4-p2@254 {
		reg = <0x254 0x1>;
		bits = <0 6>;
	};
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";
	status = "okay";

	nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		nand-ecc-engine = <&qpic_nand>;
		/*
		 * NAND ECC strength is 4-bit (step 512), NOT 8-bit.
		 * kuncy7's stock-U-Boot note ("stock U-Boot uses 8-bit ECC")
		 * does NOT apply to trigsoft-chain devices: trigsoft's
		 * modified U-Boot reads/writes NAND with 4-bit-compatible
		 * ECC, so an 8-bit kernel cannot decode trigsoft-written
		 * pages (UBI attach fails, no boot). Build #6 (8-bit)
		 * failed exactly this way via trigsoft web flash, while
		 * HZYITC 5.4 (4-bit) and ImmortalWrt (default = 4-bit)
		 * both boot. Diagnosis 2026-11-03 (build6-diagnosis).
		 */
		nand-ecc-step-size = <512>;
		nand-ecc-strength = <4>;
		nand-bus-width = <8>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:SBL1";
				reg = <0x0000000 0x0080000>;
				read-only;
			};

			partition@80000 {
				label = "0:MIBIB";
				reg = <0x0080000 0x0080000>;
				read-only;
			};

			partition@100000 {
				label = "0:BOOTCONFIG";
				reg = <0x0100000 0x0040000>;
				read-only;
			};

			partition@140000 {
				label = "0:BOOTCONFIG1";
				reg = <0x0140000 0x0040000>;
				read-only;
			};

			partition@180000 {
				label = "0:QSEE";
				reg = <0x0180000 0x0100000>;
				read-only;
			};

			partition@280000 {
				label = "0:QSEE_1";
				reg = <0x0280000 0x0100000>;
				read-only;
			};

			partition@380000 {
				label = "0:DEVCFG";
				reg = <0x0380000 0x0040000>;
				read-only;
			};

			partition@3c0000 {
				label = "0:DEVCFG_1";
				reg = <0x03c0000 0x0040000>;
				read-only;
			};

			partition@400000 {
				label = "0:CDT";
				reg = <0x0400000 0x0040000>;
				read-only;
			};

			partition@440000 {
				label = "0:CDT_1";
				reg = <0x0440000 0x0040000>;
				read-only;
			};

			partition@480000 {
				label = "0:APPSBLENV";
				reg = <0x0480000 0x0080000>;
			};

			partition@500000 {
				label = "0:APPSBL";
				reg = <0x0500000 0x0140000>;
				read-only;
			};

			partition@640000 {
				label = "0:APPSBL_1";
				reg = <0x0640000 0x0140000>;
				read-only;
			};

			partition@780000 {
				label = "0:ART";
				reg = <0x0780000 0x0100000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_art_0: mac-address@0 {
						compatible = "mac-base";
						reg = <0x0 0x6>;
						#nvmem-cell-cells = <1>;
					};

					macaddr_art_6: mac-address@6 {
						compatible = "mac-base";
						reg = <0x6 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@880000 {
				label = "0:TRAINING";
				reg = <0x0880000 0x0080000>;
				read-only;
			};

			partition@900000 {
				label = "bdata";
				reg = <0x0900000 0x0080000>;
			};

			partition@980000 {
				label = "crash";
				reg = <0x0980000 0x0080000>;
			};

			partition@a00000 {
				label = "crash_log";
				reg = <0x0a00000 0x0080000>;
			};

			partition@a80000 {
				label = "rootfs";
				reg = <0x0a80000 0x7480000>;
			};
		};
	};
};

&uniphy0 {
	status = "okay";

	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
	assigned-clock-rates = <UNIPHY_REFCLK_25MHZ>;
};

// MAC0 -> GE Phy -> QCA8337 Phy4 (WAN path)
&gmac0 {
	status = "okay";

	nvmem-cells = <&macaddr_art_0 0>;
	nvmem-cell-names = "mac-address";
};

// MAC1 ---SGMII---> QCA8337 SerDes (LAN path)
&gmac1 {
	status = "okay";

	phy-mode = "sgmii";

	nvmem-cells = <&macaddr_art_6 0>;
	nvmem-cell-names = "mac-address";

	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&mdio0 {
	status = "okay";
};

&ge_phy {
	qcom,dac-preset-short-cable;
};

&mdio1 {
	status = "okay";

	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;

	// QCA8337 Phy0 -> LAN1
	qca8337_0: ethernet-phy@0 {
		reg = <0>;
	};

	// QCA8337 Phy1 -> LAN2
	qca8337_1: ethernet-phy@1 {
		reg = <1>;
	};

	// QCA8337 Phy2 -> LAN3
	qca8337_2: ethernet-phy@2 {
		reg = <2>;
	};

	// QCA8337 Phy3 -> WAN
	qca8337_3: ethernet-phy@3 {
		reg = <3>;
	};

	// QCA8337 Phy4 -> IPQ5018 GE Phy
	qca8337_4: ethernet-phy@4 {
		reg = <4>;
	};

	switch1: ethernet-switch@17 {
		compatible = "qca,qca8337";
		reg = <17>;
		#address-cells = <1>;
		#size-cells = <0>;

		ethernet-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			ethernet-port@0 {
				reg = <0>;
				phy-mode = "sgmii";
				ethernet = <&gmac1>;
				qca,sgmii-enable-pll;

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};

			ethernet-port@1 {
				reg = <1>;
				label = "lan1";
				phy-handle = <&qca8337_0>;
			};

			ethernet-port@2 {
				reg = <2>;
				label = "lan2";
				phy-handle = <&qca8337_1>;
			};

			ethernet-port@3 {
				reg = <3>;
				label = "lan3";
				phy-handle = <&qca8337_2>;
			};

			ethernet-port@4 {
				reg = <4>;
				label = "wan";
				phy-handle = <&qca8337_3>;
				nvmem-cells = <&macaddr_art_0 0>;
				nvmem-cell-names = "mac-address";
			};

			/*
			 * Port 5 connects to GMAC0 via PHY4, but all user ports are
			 * assigned to conduit eth1 (GMAC1/port 0). Keeping port 5
			 * enabled causes the switch to flood routed/WAN frames to
			 * GMAC0, triggering high softirq packet drop storms on eth0.
			 * (Upstream a67d696c5d, 2026-11-07: disable unused port 5.)
			 */
			ethernet-port@5 {
				reg = <5>;
				phy-handle = <&qca8337_4>;
				phy-mode = "gmii";
				ethernet = <&gmac0>;
				status = "disabled";
			};
		};
	};
};

&tlmm {
	button_pins: button-state {
		pins = "gpio23", "gpio25";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	led_pins: led-state {
		pins = "gpio17", "gpio19", "gpio20", "gpio22";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	mdio1_pins: mdio-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	serial_0_pins: uart0-state {
		pins = "gpio28", "gpio29";
		function = "blsp0_uart1";
		drive-strength = <8>;
		bias-disable;
	};
};

&q6v5_wcss {
	/* QCN6122 radio on PCIe1, user PD 2, reset on GPIO27 */
	boot-args = </*       type:	*/ 0x2 /* PCIE1	*/
		     /*     length:	*/ 4
		     /*     UPD ID:	*/ 2
		     /* reset GPIO:	*/ 27
		     /*   reserved:	*/ 0 0>;
	status = "okay";
};

/*
 * 256 MiB of RAM: use the low-memory firmware profile (mode 2), as the
 * vendor firmware does (qcom,tgt-mem-mode = <2>).
 */
&wifi {
	status = "okay";
	ieee80211-freq-limit = <2400000 2483000>;

	qcom,rproc = <&q6v5_wcss>;
	qcom,board_id = <0x24>;
	qcom,ath11k-fw-memory-mode = <2>;
};

&wifi1 {
	status = "okay";

	qcom,rproc = <&q6v5_wcss>;
	qcom,board_id = <0x60>;
	qcom,ath11k-fw-memory-mode = <2>;
	ieee80211-freq-limit = <5150000 5850000>;

	memory-region = <&q6_region_qcn6122_1>, <&q6_region_ipq5018>, <&m3_dump_qcn6122_1>;
	memory-region-names = "q6-region", "m3-region", "m3-dump";
};

/* 256 MB board: NSS heap 8 MiB, as on the other QCN6122 256 MB boards */
&nss_region {
	reg = <0x0 0x40000000 0x0 0x800000>;
};

/*
 * TSENS thermal sensor + thermal zones (upstream ipq5018.dtsi, 2025):
 * IPQ5018 has a tsens v1.0 block with 5 sensors (4 in use). There is
 * no RPM, so the driver explicitly resets/enables it (standalone
 * compatible "qcom,ipq5018-tsens", no "qcom,tsens-v1" fallback).
 * The kernel already has CONFIG_QCOM_TSENS=y; without this node the
 * driver has nothing to bind to, so no thermal zone exists and LuCI
 * cannot show CPU temperature. With it, /sys/class/thermal/ appears
 * and LuCI's status page shows the CPU temperature (like the main
 * router). Critical trip is 120C (reboot); cpu_alert at 100C throttles
 * via CPU frequency scaling.
 */
&soc {
	tsens: thermal-sensor@4a9000 {
		compatible = "qcom,ipq5018-tsens";
		reg = <0x004a9000 0x1000>,
		      <0x004a8000 0x1000>;

		nvmem-cells = <&tsens_mode>,
			      <&tsens_base1>,
			      <&tsens_base2>,
			      <&tsens_s0_p1>,
			      <&tsens_s0_p2>,
			      <&tsens_s1_p1>,
			      <&tsens_s1_p2>,
			      <&tsens_s2_p1>,
			      <&tsens_s2_p2>,
			      <&tsens_s3_p1>,
			      <&tsens_s3_p2>,
			      <&tsens_s4_p1>,
			      <&tsens_s4_p2>;

		nvmem-cell-names = "mode",
				   "base1",
				   "base2",
				   "s0_p1",
				   "s0_p2",
				   "s1_p1",
				   "s1_p2",
				   "s2_p1",
				   "s2_p2",
				   "s3_p1",
				   "s3_p2",
				   "s4_p1",
				   "s4_p2";

		interrupts = <GIC_SPI 184 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "uplow";
		#qcom,sensors = <5>;
		#thermal-sensor-cells = <1>;
	};
};

/ {
	thermal-zones {
		cpu-thermal {
			thermal-sensors = <&tsens 2>;

			trips {
				cpu-critical {
					temperature = <120000>;
					hysteresis = <1000>;
					type = "critical";
				};

				cpu_alert: cpu-passive {
					temperature = <100000>;
					hysteresis = <1000>;
					type = "passive";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_alert>;
					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		gephy-thermal {
			thermal-sensors = <&tsens 4>;

			trips {
				gephy-critical {
					temperature = <120000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
		};

		top-glue-thermal {
			thermal-sensors = <&tsens 3>;

			trips {
				top-glue-critical {
					temperature = <120000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
		};

		ubi32-thermal {
			thermal-sensors = <&tsens 1>;

			trips {
				ubi32-critical {
					temperature = <120000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
		};
	};
};
